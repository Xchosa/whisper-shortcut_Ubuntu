# Prototype-only singular messages. Production uses compiled gettext.
msgid "WhisperShortcut — Desktop prototype"
msgstr "WhisperShortcut — Desktop-Prototyp"

msgid "Local tests only. Nothing is uploaded. Recording starts only when you request it."
msgstr "Nur lokale Tests. Es wird nichts hochgeladen. Eine Aufnahme beginnt nur auf Ihre Anforderung."

msgid "Idle"
msgstr "Bereit"

msgid "Finding audio sources…"
msgstr "Audioquellen werden gesucht…"

msgid "Microphone source"
msgstr "Mikrofonquelle"

msgid "System monitor source (default: @DEFAULT_MONITOR@)"
msgstr "System-Monitorquelle (Standard: @DEFAULT_MONITOR@)"

msgid "Record microphone"
msgstr "Mikrofon aufnehmen"

msgid "Record system audio"
msgstr "Systemaudio aufnehmen"

msgid "Record microphone + system audio"
msgstr "Mikrofon und Systemaudio aufnehmen"

msgid "Stop and finalize"
msgstr "Stoppen und abschließen"

msgid "Cancel / delete test audio"
msgstr "Abbrechen / Testaudio löschen"

msgid "Play last recording"
msgstr "Letzte Aufnahme abspielen"

msgid "Copy harmless test text"
msgstr "Unverfänglichen Testtext kopieren"

msgid "Shortcut setup"
msgstr "Tastenkürzel einrichten"

msgid "Test disposable keyring value"
msgstr "Temporären Schlüsselbundeintrag testen"

msgid "Cancel keyring test"
msgstr "Schlüsselbundtest abbrechen"

msgid "Quit"
msgstr "Beenden"

msgid "Keep running when the window closes"
msgstr "Nach dem Schließen des Fensters weiterlaufen"

msgid "Audio source discovery failed."
msgstr "Die Suche nach Audioquellen ist fehlgeschlagen."

msgid "No microphone sources found"
msgstr "Keine Mikrofonquellen gefunden"

msgid "Stop or cancel recording before closing."
msgstr "Stoppen Sie die Aufnahme oder brechen Sie diese vor dem Schließen ab."

msgid "Another recording is active."
msgstr "Eine andere Aufnahme läuft bereits."

msgid "Recording — use Stop to finalize or Cancel to delete."
msgstr "Aufnahme läuft — mit Stoppen abschließen oder mit Abbrechen löschen."

msgid "Audio capture failed. Check source, permissions and device availability."
msgstr "Audioaufnahme fehlgeschlagen. Prüfen Sie Quelle, Berechtigungen und Geräteverfügbarkeit."

msgid "Audio operation failed. Check device availability."
msgstr "Audiovorgang fehlgeschlagen. Prüfen Sie die Geräteverfügbarkeit."

msgid "Recording saved locally. Listen back to verify both content and sources."
msgstr "Aufnahme lokal gespeichert. Hören Sie diese zur Prüfung der Inhalte und Quellen ab."

msgid "Playback finished."
msgstr "Wiedergabe beendet."

msgid "Recording — seconds elapsed: {seconds}"
msgstr "Aufnahme — vergangene Sekunden: {seconds}"

msgid "Finalizing recording…"
msgstr "Aufnahme wird abgeschlossen…"

msgid "Audio finalization timed out; incomplete test audio was deleted."
msgstr "Zeitüberschreitung beim Abschließen; unvollständiges Testaudio wurde gelöscht."

msgid "Stop recording or playback first."
msgstr "Stoppen Sie zuerst die Aufnahme oder Wiedergabe."

msgid "No test recording available."
msgstr "Keine Testaufnahme verfügbar."

msgid "On GNOME: Settings → Keyboard → Custom Shortcuts. Bind the documented command ending in --toggle-recording. Do not register it until microphone recording works."
msgstr "Unter GNOME: Einstellungen → Tastatur → Eigene Tastenkombinationen. Weisen Sie den dokumentierten Befehl mit --toggle-recording zu. Richten Sie dies erst nach erfolgreichem Mikrofontest ein."

msgid "Keyring test already running."
msgstr "Der Schlüsselbundtest läuft bereits."

msgid "Testing a disposable keyring value…"
msgstr "Ein temporärer Schlüsselbundeintrag wird getestet…"

msgid "Disposable keyring value removed."
msgstr "Temporärer Schlüsselbundeintrag entfernt."

msgid "Keyring test passed; disposable value removed."
msgstr "Schlüsselbundtest erfolgreich; temporärer Eintrag entfernt."

msgid "Keyring test cancelled or failed; disposable item cleanup finished."
msgstr "Schlüsselbundtest abgebrochen oder fehlgeschlagen; Bereinigung des temporären Eintrags abgeschlossen."

msgid "Keyring cleanup failed; remove the prototype test item manually."
msgstr "Schlüsselbundbereinigung fehlgeschlagen. Entfernen Sie den Testeintrag des Prototyps manuell."

msgid "Disposable value matched."
msgstr "Der temporäre Wert stimmt überein."

msgid "Keyring verification failed."
msgstr "Schlüsselbundprüfung fehlgeschlagen."

msgid "Keyring test cancelled or unavailable."
msgstr "Schlüsselbundtest abgebrochen oder nicht verfügbar."

msgid "Cancelling keyring test; cleanup will follow."
msgstr "Schlüsselbundtest wird abgebrochen; Bereinigung folgt."

msgid "Wait for keyring cleanup before quitting."
msgstr "Warten Sie vor dem Beenden auf die Schlüsselbundbereinigung."

msgid "Stop or cancel recording before quitting."
msgstr "Stoppen Sie die Aufnahme oder brechen Sie diese vor dem Beenden ab."

msgid "WhisperShortcut — Transcription prototype"
msgstr "WhisperShortcut — Transkriptionsprototyp"

msgid "Transcription uses the local container by default. OpenRouter requires explicit cloud configuration. Nothing is transcribed until you click Transcribe."
msgstr "Die Transkription verwendet standardmäßig den lokalen Container. OpenRouter erfordert eine ausdrückliche Cloud-Konfiguration. Die Transkription startet erst mit einem Klick auf Transkribieren."

msgid "Transcript"
msgstr "Transkript"

msgid "Transcript history is not saved. Copy your text before quitting."
msgstr "Ein Transkriptverlauf wird nicht gespeichert. Kopieren Sie Ihren Text vor dem Beenden."

msgid "Cancel operation"
msgstr "Vorgang abbrechen"

msgid "Transcribe recording"
msgstr "Aufnahme transkribieren"

msgid "Transcribe recording (local CPU)"
msgstr "Aufnahme transkribieren (lokale CPU)"

msgid "Transcribe recording (OpenRouter cloud)"
msgstr "Aufnahme transkribieren (OpenRouter-Cloud)"

msgid "Copy transcript"
msgstr "Transkript kopieren"

msgid "Cancel transcription before closing."
msgstr "Brechen Sie die Transkription vor dem Schließen ab."

msgid "Cancel transcription before quitting."
msgstr "Brechen Sie die Transkription vor dem Beenden ab."

msgid "Another operation is active."
msgstr "Ein anderer Vorgang ist noch aktiv."

msgid "No completed recording is available."
msgstr "Es ist keine abgeschlossene Aufnahme verfügbar."

msgid "Provider changed. Review the displayed provider, then press Transcribe again."
msgstr "Der Anbieter wurde geändert. Prüfen Sie den angezeigten Anbieter und klicken Sie erneut auf Transkribieren."

msgid "Transcribing locally…"
msgstr "Wird lokal transkribiert…"

msgid "Transcribing with OpenRouter…"
msgstr "Wird mit OpenRouter transkribiert…"

msgid "Transcription could not start. Your recording is kept for retry."
msgstr "Die Transkription konnte nicht starten. Ihre Aufnahme bleibt für einen erneuten Versuch erhalten."

msgid "Transcription complete. Use Copy transcript to copy it."
msgstr "Transkription abgeschlossen. Mit Transkript kopieren können Sie den Text kopieren."

msgid "Transcription cancelled. Your recording is kept for retry."
msgstr "Transkription abgebrochen. Ihre Aufnahme bleibt für einen erneuten Versuch erhalten."

msgid "No transcript is available."
msgstr "Es ist kein Transkript verfügbar."

msgid "Transcript copied."
msgstr "Transkript kopiert."

msgid "Set OPENROUTER_API_KEY in env/.env or the process environment."
msgstr "Setzen Sie OPENROUTER_API_KEY in env/.env oder in der Prozessumgebung."

msgid "Set OPENROUTER_TRANSCRIPTION_MODEL; the generation model is not used for audio."
msgstr "Setzen Sie OPENROUTER_TRANSCRIPTION_MODEL. Das Generierungsmodell wird nicht für Audio verwendet."

msgid "The development configuration is invalid or unreadable. Check its KEY=value entries."
msgstr "Die Entwicklungskonfiguration ist ungültig oder nicht lesbar. Prüfen Sie die Einträge im Format KEY=value."

msgid "The recording is not a valid non-empty WAV file."
msgstr "Die Aufnahme ist keine gültige WAV-Datei mit Audioinhalt."

msgid "The recording exceeds the prototype's 20 MB audio limit."
msgstr "Die Aufnahme überschreitet das Audiolimit von 20 MB dieses Prototyps."

msgid "Use a recording of at most five minutes for this prototype."
msgstr "Verwenden Sie für diesen Prototyp eine Aufnahme von höchstens fünf Minuten."

msgid "OpenRouter rejected the API key. Check your local configuration."
msgstr "OpenRouter hat den API-Schlüssel abgelehnt. Prüfen Sie Ihre lokale Konfiguration."

msgid "OpenRouter requires available credit for this transcription."
msgstr "OpenRouter benötigt verfügbares Guthaben für diese Transkription."

msgid "OpenRouter is rate limiting requests. Try again later."
msgstr "OpenRouter begrenzt derzeit die Anfragerate. Versuchen Sie es später erneut."

msgid "OpenRouter rejected the audio or model, or the provider is unavailable."
msgstr "OpenRouter hat die Audiodaten oder das Modell abgelehnt, oder der Anbieter ist nicht verfügbar."

msgid "The transcription connection failed. Your recording is kept for retry."
msgstr "Die Verbindung für die Transkription ist fehlgeschlagen. Ihre Aufnahme bleibt für einen erneuten Versuch erhalten."

msgid "Transcription timed out. Your recording is kept for retry."
msgstr "Zeitüberschreitung bei der Transkription. Ihre Aufnahme bleibt für einen erneuten Versuch erhalten."

msgid "The transcription service returned an invalid or empty transcript."
msgstr "Der Transkriptionsdienst hat ein ungültiges oder leeres Transkript zurückgegeben."

msgid "The local transcription container is unavailable. Start it with the documented command."
msgstr "Der lokale Transkriptionscontainer ist nicht erreichbar. Starten Sie diesen mit dem dokumentierten Befehl."

msgid "The local model is busy. Try again shortly."
msgstr "Das lokale Modell ist beschäftigt. Versuchen Sie es in Kürze erneut."

msgid "The local transcription service rejected the request or could not transcribe it."
msgstr "Der lokale Transkriptionsdienst hat die Anfrage abgelehnt oder konnte sie nicht transkribieren."
