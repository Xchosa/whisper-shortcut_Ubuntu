# Development only. Keep real credentials in the ignored env/.env file.
# Local CPU transcription is the default and needs no API key.
TRANSCRIPTION_PROVIDER=local
LOCAL_TRANSCRIPTION_URL=http://127.0.0.1:8765
LOCAL_TRANSCRIPTION_MODEL=base
# To use cloud transcription, explicitly set TRANSCRIPTION_PROVIDER=openrouter.
OPENROUTER_API_KEY=your_openrouter_api_key
OPENROUTER_GENERATION_MODEL=openrouter/free
OPENROUTER_TRANSCRIPTION_MODEL=openai/whisper-large-v3-turbo
